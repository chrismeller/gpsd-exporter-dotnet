<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GpsdExporter</RootNamespace>
    <AssemblyName>gpsd-exporter</AssemblyName>

    <!-- Native AOT. IsAotCompatible turns on the trim, AOT and single-file analyzers for
         every build, so problems show up long before publish. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GpsdExporter.ServiceDefaults/GpsdExporter.ServiceDefaults.csproj" />
    <ProjectReference Include="../GpsdExporter.Core/GpsdExporter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GpsdExporter.Tests.Host" />
  </ItemGroup>
</Project>
