      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpsd_tpv_mode{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "range": true
