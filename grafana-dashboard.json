                  "index": 1
                },
                "2": {
                  "text": "DGPS",
                  "index": 2
                },
                "3": {
                  "text": "RTK fixed",
                  "index": 3
                },
                "4": {
                  "text": "RTK float",
                  "index": 4
                },
                "5": {
                  "text": "Dead reckoning",
                  "index": 5
                },
                "6": {
                  "text": "GNSS + DR",
