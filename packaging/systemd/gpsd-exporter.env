# Settings for the gpsd-exporter systemd unit, installed as /etc/default/gpsd-exporter.
# Every setting is a GPSD_EXPORTER_ variable: the section and key joined by a double
# underscore. Uncomment and change what you need; the defaults are shown.

# gpsd to connect to (host:port; IPv6 in brackets).
#GPSD_EXPORTER_GPSD__ADDRESS=localhost:2947

# Watch only this device instead of every device gpsd knows.
#GPSD_EXPORTER_GPSD__DEVICE=/dev/ttyACM0

# Ask gpsd for PPS and TOFF reports.
#GPSD_EXPORTER_GPSD__PPS=true

# HTTP listen address ([addr]:port; :9978 listens on every address) and metrics path.
#GPSD_EXPORTER_HTTP__LISTEN=:9978
#GPSD_EXPORTER_HTTP__METRICSPATH=/metrics

# Per-satellite series, and .NET runtime and process metrics on /metrics.
#GPSD_EXPORTER_METRICS__SATELLITES=true
#GPSD_EXPORTER_METRICS__RUNTIME=false

# How long a value is served after it was received.
#GPSD_EXPORTER_STALENESS__TPV=00:00:10
#GPSD_EXPORTER_STALENESS__SKY=00:00:30

# Console log format (text or json) and level.
#GPSD_EXPORTER_LOGGING__FORMAT=text
#GPSD_EXPORTER_LOGGING__LOGLEVEL__DEFAULT=Information

# Send the exporter's own metrics and logs over OTLP (never the gpsd metrics).
#GPSD_EXPORTER_OTLP__ENDPOINT=http://collector:4317
# Or the standard OpenTelemetry variables. Use http/protobuf for a collector's HTTP port (4318).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
#OTEL_EXPORTER_OTLP_PROTOCOL=grpc
#OTEL_SERVICE_NAME=gpsd-exporter
