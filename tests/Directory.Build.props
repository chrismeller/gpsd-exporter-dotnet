<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- GpsdExporter.Testing is a plain class library of shared test helpers
       (fixture loader, FakeGpsd, Prometheus text parser); everything else is a test project. -->
  <PropertyGroup>
    <IsSharedTestSupport Condition="'$(MSBuildProjectName)' == 'GpsdExporter.Testing'">true</IsSharedTestSupport>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Underscores in test method names are the convention here. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSharedTestSupport)' != 'true'">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 on Microsoft Testing Platform v2; global.json selects MTP for dotnet test. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSharedTestSupport)' != 'true'">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(IsSharedTestSupport)' != 'true'">
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <!-- The gpsd fixtures (tests/fixtures) are copied next to every test assembly. -->
  <ItemGroup Condition="'$(IsSharedTestSupport)' != 'true'">
    <None Include="$(MSBuildThisFileDirectory)fixtures/**/*"
          Link="fixtures/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <!-- The Grafana dashboard, checked against the catalogue (T9.1) and imported into Grafana. -->
    <None Include="$(MSBuildThisFileDirectory)../grafana-dashboard.json"
          Link="grafana-dashboard.json"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
